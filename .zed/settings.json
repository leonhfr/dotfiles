{
  "file_types": {
    "Shell Script": [
      "*.sh.tmpl",
      "*.zsh.tmpl",
      "dot_zprofile.tmpl",
      "dot_zshrc.tmpl",
    ],
    "JSON": ["*.json.tmpl"],
    "JSONC": ["**/zed/*.json"],
    "Markdown": ["*.md.tmpl"],
    "INI": ["**/pgcli/config", "**/git/config.tmpl"],
    "YAML": ["*.yml.tmpl", "*.yaml.tmpl"],
    "TOML": ["*.toml.tmpl", "*.ghostty"],
    "Git Config": ["**/git/config.tmpl"],
    "Go Text Template": ["**/dot_claude/settings.json.tmpl", ".chezmoiignore"],
    "XML": ["*.plist", "*.plist.tmpl", "*.tmTheme"],
  },
  "languages": {
    "XML": {
      "prettier": {
        "allowed": false,
      },
    },
  },
  "lsp": {
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": [
                "**/.chezmoitemplates/claude_settings.json",
                "**/.chezmoitemplates/claude_settings_personal.json",
                "**/.chezmoitemplates/encrypted_claude_settings_work.json",
              ],
              "url": "https://json.schemastore.org/claude-code-settings.json",
            },
          ],
        },
      },
    },
  },
}
