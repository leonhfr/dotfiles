amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

fail_fast = false

hooks {
    ["pre-commit"] {
        steps {
            ["gitleaks"] = Builtins.gitleaks
            ["plaintext-keywords"] {
                check = "bin/check-plaintext-keywords.sh"
                allow_failure = true
            }
            ["chezmoiremove"] {
                check = "bin/check-chezmoiremove.sh"
                allow_failure = true
            }
            ["skill-tags"] {
                check = "bin/check-skill-tags.sh"
                allow_failure = true
            }
            ["repos-sync"] {
                check = "bin/check-repos-sync.sh"
            }
        }
    }
}
