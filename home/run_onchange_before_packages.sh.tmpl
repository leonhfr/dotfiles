{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

eval "$(/opt/homebrew/bin/brew shellenv)"

echo "[dotfiles] Installing packages"

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

if ! command -v cargo >/dev/null 2>&1; then
    echo "[dotfiles] Installing Rust"
    rustup-init -y
fi

rustup component add rust-src

echo "[dotfiles] Installing go packages"

{{ range .packages.go -}}
go install {{ . }}
{{ end -}}

echo "[dotfiles] Installing VSCode extensions"

{{ range .packages.vscode -}}
code --force --install-extension {{ . | quote }}
{{ end -}}

{{ end -}}
