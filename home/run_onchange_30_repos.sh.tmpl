{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

{{ range .repos -}}
if [ ! -d "{{ .path }}" ]; then
    echo "[dotfiles] Cloning {{ .name }}..."
    git clone git@github.com:{{ $.git.github }}/{{ .name }}.git ~/{{ .path }}
else
    echo "[dotfiles] {{ .name }} already exists, skipping"
fi

{{ end -}}
{{ end -}}
