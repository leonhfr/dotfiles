{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
{{ end }}

{{ if ne .machine "personal" }}
.config/cargo/**
.local/share/navi/cheats/personal/**
{{ end }}

{{ if ne .machine "work" }}
.config/pgcli/**
.local/share/navi/cheats/work/**
.ssh/id_ed25519_work
.ssh/id_ed25519_work.pub
.zshrc_work.zsh
work/.envrc
work/.gitconfig
{{ end }}

{{ range $bucket := list .brews .casks -}}
{{   range $m, $pkgs := $bucket -}}
{{     if and (ne $m "common") (ne $m $.machine) -}}
{{       range $pkgs -}}
{{         $name := . | splitList "/" | last }}
.local/share/navi/cheats/{{ $name }}.cheat
{{       end -}}
{{     end -}}
{{   end -}}
{{ end -}}
