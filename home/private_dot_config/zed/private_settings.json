// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tabs": {
    "git_status": true,
  },
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 12,
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },

  // Editor
  "tab_size": 2,
  "hard_tabs": false,
  "show_whitespaces": "all",
  "indent_guides": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,

  // Project panel
  "project_panel": {},

  // Telemetry
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },

  // Terminal
  "terminal": {
    "font_size": 12,
    "option_as_meta": true,
  },

  // Extensions
  "auto_install_extensions": {
    "codebook": true,
    "docker-compose": false,
    "dockerfile": true,
    "git-firefly": true,
    "go-snippets": false,
    "golangci-lint": true,
    "html": true,
    "ini": true,
    "pkl": true,
    "sql": true,
    "terraform": false,
    "toml": true,
  },

  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
  },

  // Language-specific
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint", "..."],
    },
    "Markdown": {
      "format_on_save": "on",
    },
    "Rust": {
      "tab_size": 4,
    },
  },
}
