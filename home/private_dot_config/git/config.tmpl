{{- $user := ternary .work .personal (eq .machine "work") -}}
{{ template "git-user" $user -}}

[core]
  editor = micro
  autocrlf = input
  excludesfile = ~/git/ignore
  whitespace = trailing-space,space-before-tab
  pager = delta

[branch]
  sort = -committerdate

[column]
  ui = auto

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[diff]
  algorithm = histogram
  colorMoved = plain

[merge]
  conflictStyle = zdiff3

[pager]
  branch = false
  grep = false

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[fetch]
  prune = true

[alias]
  configs = config --list --show-origin
  hist = log --graph --pretty=format:'%Cred%h%Creset %s%C(yellow)%d%Creset %Cgreen(%cr)%Creset [%an]' --abbrev-commit --date=relative
  append = town append
  continue = town continue
  delete = town delete
  diff-parent = town diff-parent
  down = town down
  hack = town hack
  prepend = town prepend
  propose = town propose
  rename = town rename
  set-parent = town set-parent
  ship = town ship
  sync = town sync
  up = town up

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

{{ if eq .chezmoi.os "darwin" -}}
[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true
{{ end -}}

{{ if eq .machine "work" -}}
[url "git@github-personal:{{ .personal.github }}/"]
  insteadOf = git@github.com:{{ .personal.github }}/

[url "git@github-personal:{{ .personal.github }}/"]
  insteadOf = https://github.com/{{ .personal.github }}/

[includeIf "hasconfig:remote.*.url:git@github-personal:*"]
  path = ~/.config/git/personal
{{- else -}}
[url "git@github.com:{{ .personal.github }}/"]
  insteadOf = https://github.com/{{ .personal.github }}/
{{- end }}

{{- $ghPath := lookPath "gh" -}}
{{ if $ghPath -}}
[credential "https://github.com"]
  helper = !{{ $ghPath }} auth git-credential
[credential "https://gist.github.com"]
  helper = !{{ $ghPath }} auth git-credential
{{ end -}}
