#!/bin/sh
### git-wt — create a git worktree interactively
###
### Usage:
###   git-wt
###
### Options:
###   -h   Show this message.

set -eu

if [ "${1:-}" = "-h" ]; then
  sed -rn 's/^### ?//p' "$0"
  exit 0
fi

if ! command -v gum > /dev/null 2>&1; then
  echo "Error: gum is not installed"
  exit 1
fi

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  gum style --foreground 196 "Error: not in a git repository"
  exit 1
fi

CURRENT_DIR=$(basename "$PWD")

if git show-ref --verify --quiet refs/heads/main; then
  DEFAULT_BRANCH="main"
elif git show-ref --verify --quiet refs/heads/master; then
  DEFAULT_BRANCH="master"
else
  gum style --foreground 196 "Error: neither 'main' nor 'master' branch found"
  exit 1
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

gum style --foreground 212 "repo: $CURRENT_DIR  default branch: $DEFAULT_BRANCH"
echo

SUFFIX=$(gum input --placeholder "worktree suffix (becomes branch name)")
if [ -z "$SUFFIX" ]; then
  gum style --foreground 196 "Error: suffix cannot be empty"
  exit 1
fi

WORKTREE_DIR="../${CURRENT_DIR}-${SUFFIX}"
BRANCH_NAME="$SUFFIX"

if [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
  BASE_BRANCH=$(gum choose --header "Base branch" "$DEFAULT_BRANCH" "$CURRENT_BRANCH") || exit 0
else
  BASE_BRANCH="$DEFAULT_BRANCH"
fi

gum confirm "Create $WORKTREE_DIR from $BASE_BRANCH?" || exit 0

gum spin --spinner dot --title "Creating worktree..." -- \
  git worktree add "$WORKTREE_DIR" -b "$BRANCH_NAME" "$BASE_BRANCH"

gum style --foreground 42 "worktree created at $WORKTREE_DIR"
echo

cd "$WORKTREE_DIR" || exit 1
exec "$SHELL"
