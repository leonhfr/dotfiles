#!/bin/bash
### ghdash-review-pr — open a herdr tab and run /review-pr for a github PR
###
### Usage: ghdash-review-pr <owner/repo> <pr-number>
### Called from the gh-dash keybinding (key C, prs section).

set -euo pipefail

REPO="${1:?repo required (owner/repo)}"
PR="${2:?pr number required}"

[ -z "${HERDR_WORKSPACE_ID:-}" ] && exit 0

SHORT_REPO="${REPO##*/}"
LABEL="${SHORT_REPO}#${PR}"
PR_URL="https://github.com/${REPO}/pull/${PR}"

REPO_PATH=$(ghq list --full-path --exact "github.com/${REPO}" 2>/dev/null | head -1)

# Create a new focused tab in the current workspace
CREATE_ARGS=(--workspace "$HERDR_WORKSPACE_ID" --label "$LABEL" --focus)
[ -n "$REPO_PATH" ] && CREATE_ARGS+=(--cwd "$REPO_PATH")
CREATE_OUT=$(herdr tab create "${CREATE_ARGS[@]}")
PANE_ID=$(printf '%s' "$CREATE_OUT" | jq -r '.result.root_pane.pane_id')

# Detach from gh-dash: wait for the shell, start claude, submit the prompt
AGENT="review-pr-${PR}"
{
  herdr pane run "$PANE_ID" "echo PANE_READY"
  herdr pane wait-output "$PANE_ID" --match "PANE_READY" --timeout 10000
  herdr agent start "$AGENT" --kind claude --pane "$PANE_ID" --timeout 90000
  herdr agent prompt "$AGENT" "/review-pr ${PR_URL}"
} &>/dev/null &
disown $!
