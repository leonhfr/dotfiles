#!/bin/sh
### repos — maintenance commands for all ghq-managed repos
###
### Usage:
###   repos check [-s]
###   repos pull [-f] [-s]
###   repos switch [-s]
###   repos clean [-f] [-s]
###   repos claude-local
###   repos skills
###
### Subcommands:
###   check         Show dirty state: uncommitted files, unpushed commits, stash, pushed branches.
###   pull          Pull default branch for each repo. Skips repos not currently on
###                 the default branch, and skips repos with uncommitted changes or
###                 unpushed commits unless -f is given.
###   switch        Switch to default branch for each repo.
###   clean         Delete branches whose PR was merged. With -f, delete all branches
###                 with no remote tracking except main and master.
###   claude-local  Review and optionally delete per-repo local Claude settings.
###   skills        List skills (.claude/skills, .agents/skills) found across all repos.
###
### Options:
###   -f, --force       (pull) Pull even if the repo has uncommitted changes or unpushed commits.
###   -f, --force       (clean) Delete all branches with no upstream or whose upstream is gone, except main and master.
###   -s, --sequential  Process repos one at a time instead of in parallel, with no
###                     progress spinner. Produces clean, ordered output for logs.
###   -h                Show this message.

set -eu

YELLOW=$(printf '\033[38;5;226m')
GREEN=$(printf '\033[38;5;42m')
RED=$(printf '\033[38;5;196m')
RESET=$(printf '\033[0m')

usage() {
  sed -rn 's/^### ?//p' "$0"
}

require() {
  for cmd in "$@"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Error: $cmd is not installed" >&2
      exit 1
    fi
  done
}

# Resolve the default branch for a local repo.
# Prefers refs/remotes/origin/HEAD, falls back to checking main then master.
default_branch() {
  DIR="$1"
  BRANCH=$(git -C "$DIR" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##')
  if [ -z "$BRANCH" ]; then
    if git -C "$DIR" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
      BRANCH="main"
    elif git -C "$DIR" show-ref --verify --quiet refs/heads/master 2>/dev/null; then
      BRANCH="master"
    fi
  fi
  printf '%s' "$BRANCH"
}

# Run FUNC in parallel for every repo reported by ghq, then print results in
# ghq list order. FUNC receives (REPO DIR OUTFILE) and writes its output to OUTFILE.
run_parallel() {
  FUNC="$1"
  TMP=$(mktemp -d)

  if [ "${SEQUENTIAL:-0}" = "1" ]; then
    while IFS= read -r REPO; do
      [ -n "$REPO" ] || continue
      DIR=$(ghq list --full-path --exact "$REPO")
      [ -f "$DIR/.git" ] && continue
      OUT="$TMP/out"
      rm -f "$OUT"
      "$FUNC" "$REPO" "$DIR" "$OUT"
      [ -s "$OUT" ] && cat "$OUT"
    done <<EOF
$(ghq list)
EOF
    rm -rf "$TMP"
    return
  fi

  DONE="$TMP/done"
  mkdir "$DONE"
  I=0
  while IFS= read -r REPO; do
    [ -n "$REPO" ] || continue
    DIR=$(ghq list --full-path --exact "$REPO")
    [ -f "$DIR/.git" ] && continue
    (
      trap "touch '$DONE/$I'" EXIT
      "$FUNC" "$REPO" "$DIR" "$TMP/$I"
    ) &
    I=$((I + 1))
  done <<EOF
$(ghq list)
EOF
  TOTAL=$I
  while true; do
    COMPLETED=$(ls "$DONE" | wc -l | tr -d ' ')
    printf '\r  %s / %s' "$COMPLETED" "$TOTAL"
    if [ "$COMPLETED" -eq "$TOTAL" ]; then break; fi
    sleep 0.1
  done
  wait
  printf '\r\033[K'
  J=0
  while [ "$J" -lt "$TOTAL" ]; do
    [ -s "$TMP/$J" ] && cat "$TMP/$J"
    J=$((J + 1))
  done
  rm -rf "$TMP"
}

check_repo() {
  REPO="$1"; DIR="$2"; OUT="$3"
  DIRTY=$(git -C "$DIR" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  UNPUSHED=$(git -C "$DIR" log --branches --not --remotes --oneline 2>/dev/null | wc -l | tr -d ' ')
  STASH=$(git -C "$DIR" stash list 2>/dev/null | wc -l | tr -d ' ')
  PUSHED=$(git -C "$DIR" branch --format '%(refname:short) %(upstream:short)' 2>/dev/null \
    | awk '$2 != "" && $1 != "main" && $1 != "master" {c++} END {print c+0}')
  CURRENT=$(git -C "$DIR" branch --show-current 2>/dev/null)
  case "$CURRENT" in main|master) CURRENT="" ;; esac
  if [ "$DIRTY" -gt 0 ] || [ "$UNPUSHED" -gt 0 ] || [ "$STASH" -gt 0 ] || [ "$PUSHED" -gt 0 ] || [ -n "$CURRENT" ]; then
    PARTS=""
    [ "$DIRTY" -gt 0 ]    && PARTS="${PARTS}  dirty:${DIRTY}"
    [ "$UNPUSHED" -gt 0 ] && PARTS="${PARTS}  unpushed:${UNPUSHED}"
    [ "$STASH" -gt 0 ]    && PARTS="${PARTS}  stash:${STASH}"
    [ "$PUSHED" -gt 0 ]   && PARTS="${PARTS}  pushed:${PUSHED}"
    [ -n "$CURRENT" ]     && PARTS="${PARTS}  branch:${CURRENT}"
    printf '%s%s%s%s\n' "$YELLOW" "$REPO" "$RESET" "$PARTS" > "$OUT"
  fi
}

pull_repo() {
  REPO="$1"; DIR="$2"; OUT="$3"
  BRANCH=$(default_branch "$DIR")
  if [ -z "$BRANCH" ]; then
    printf '%s%s%s  no default branch\n' "$RED" "$REPO" "$RESET" > "$OUT"
    return
  fi
  CURRENT=$(git -C "$DIR" branch --show-current 2>/dev/null)
  if [ "$CURRENT" != "$BRANCH" ]; then
    printf '%s%s%s  skipped  branch:%s\n' "$YELLOW" "$REPO" "$RESET" "$CURRENT" > "$OUT"
    return
  fi
  if [ "${FORCE:-0}" = "0" ]; then
    DIRTY=$(git -C "$DIR" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    UNPUSHED=$(git -C "$DIR" log --branches --not --remotes --oneline 2>/dev/null | wc -l | tr -d ' ')
    if [ "$DIRTY" -gt 0 ] || [ "$UNPUSHED" -gt 0 ]; then
      PARTS=""
      [ "$DIRTY" -gt 0 ]    && PARTS="${PARTS}  dirty:${DIRTY}"
      [ "$UNPUSHED" -gt 0 ] && PARTS="${PARTS}  unpushed:${UNPUSHED}"
      printf '%s%s%s  skipped%s\n' "$YELLOW" "$REPO" "$RESET" "$PARTS" > "$OUT"
      return
    fi
  fi
  if git -C "$DIR" pull origin "$BRANCH" > /dev/null 2>&1; then
    printf '%s%s%s  pulled %s\n' "$GREEN" "$REPO" "$RESET" "$BRANCH" > "$OUT"
  else
    printf '%s%s%s  pull failed (%s)\n' "$RED" "$REPO" "$RESET" "$BRANCH" > "$OUT"
  fi
}

switch_repo() {
  REPO="$1"; DIR="$2"; OUT="$3"
  BRANCH=$(default_branch "$DIR")
  if [ -z "$BRANCH" ]; then
    printf '%s%s%s  no default branch\n' "$RED" "$REPO" "$RESET" > "$OUT"
    return
  fi
  if git -C "$DIR" checkout "$BRANCH" > /dev/null 2>&1; then
    printf '%s%s%s  switched to %s\n' "$GREEN" "$REPO" "$RESET" "$BRANCH" > "$OUT"
  else
    printf '%s%s%s  checkout failed (%s)\n' "$RED" "$REPO" "$RESET" "$BRANCH" > "$OUT"
  fi
}

clean_repo() {
  REPO="$1"; DIR="$2"; OUT="$3"
  DELETED=0
  FAILED=0

  if [ "${FORCE:-0}" = "1" ]; then
    git -C "$DIR" fetch --prune --quiet 2>/dev/null
    BRANCHES=$(git -C "$DIR" branch --format '%(refname:short) %(upstream:short) %(upstream:track)' 2>/dev/null \
      | awk '($2 == "" || $3 == "[gone]") && $1 != "main" && $1 != "master" {print $1}')
    for BRANCH in $BRANCHES; do
      if git -C "$DIR" branch -D "$BRANCH" > /dev/null 2>&1; then
        DELETED=$((DELETED + 1))
      else
        FAILED=$((FAILED + 1))
      fi
    done
  else
    BRANCHES=$(git -C "$DIR" branch --format '%(refname:short)' 2>/dev/null \
      | awk '$1 != "main" && $1 != "master" {print $1}')
    for BRANCH in $BRANCHES; do
      if ( cd "$DIR" && gh pr list --state merged --head "$BRANCH" --json number 2>/dev/null ) | grep -q '"number"'; then
        if git -C "$DIR" branch -D "$BRANCH" > /dev/null 2>&1; then
          DELETED=$((DELETED + 1))
        else
          FAILED=$((FAILED + 1))
        fi
      fi
    done
  fi

  if [ "$DELETED" -gt 0 ] || [ "$FAILED" -gt 0 ]; then
    MSG=""
    [ "$DELETED" -gt 0 ] && MSG="${MSG}  deleted:${DELETED}"
    [ "$FAILED" -gt 0 ]  && MSG="${MSG}  failed:${FAILED}"
    COLOR="$GREEN"
    [ "$FAILED" -gt 0 ] && COLOR="$RED"
    printf '%s%s%s%s\n' "$COLOR" "$REPO" "$RESET" "$MSG" > "$OUT"
  fi
}

cmd_check() {
  require ghq git
  SEQUENTIAL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--sequential) SEQUENTIAL=1; shift ;;
      *) printf '%srepos check: unknown option %s%s\n' "$RED" "'$1'" "$RESET" >&2; exit 1 ;;
    esac
  done
  run_parallel check_repo
}

cmd_switch() {
  require ghq git
  SEQUENTIAL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--sequential) SEQUENTIAL=1; shift ;;
      *) printf '%srepos switch: unknown option %s%s\n' "$RED" "'$1'" "$RESET" >&2; exit 1 ;;
    esac
  done
  run_parallel switch_repo
}

cmd_clean() {
  require ghq git gh
  FORCE=0
  SEQUENTIAL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) FORCE=1; shift ;;
      -s|--sequential) SEQUENTIAL=1; shift ;;
      *) printf '%srepos clean: unknown option %s%s\n' "$RED" "'$1'" "$RESET" >&2; exit 1 ;;
    esac
  done
  run_parallel clean_repo
}

cmd_pull() {
  require ghq git
  FORCE=0
  SEQUENTIAL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) FORCE=1; shift ;;
      -s|--sequential) SEQUENTIAL=1; shift ;;
      *) printf '%srepos pull: unknown option %s%s\n' "$RED" "'$1'" "$RESET" >&2; exit 1 ;;
    esac
  done
  run_parallel pull_repo
}

# skill_field FILE FIELD -> the value of FIELD in FILE's YAML frontmatter,
# stripped of surrounding quotes. Empty if the field or frontmatter is absent.
skill_field() {
  awk -v field="$2" '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---" { exit }
    infm && $0 ~ "^" field ":" {
      sub("^" field ":[ \t]*", "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$1"
}

cmd_claude_local() {
  require ghq bat gum

  FOUND=0
  DELETED=0
  REPOS_FILE=$(mktemp)
  ghq list --full-path > "$REPOS_FILE"
  exec 3< "$REPOS_FILE"
  while IFS= read -r REPO <&3; do
    [ -f "$REPO/.git" ] && continue
    SETTINGS="$REPO/.claude/settings.local.json"
    [ -f "$SETTINGS" ] || continue
    FOUND=$((FOUND + 1))

    gum style --foreground 212 "$REPO"
    bat --pager=never --language=json "$SETTINGS"

    CONFIRM_RC=0
    gum confirm --default=false "Delete?" || CONFIRM_RC=$?
    case "$CONFIRM_RC" in
      0)
        rm "$SETTINGS"
        rmdir "$REPO/.claude" 2>/dev/null || true
        DELETED=$((DELETED + 1))
        ;;
      1) ;;
      *) break ;;
    esac
  done
  exec 3<&-
  rm -f "$REPOS_FILE"

  if [ "$FOUND" -eq 0 ]; then
    gum style --foreground 42 "no local claude settings found"
  else
    gum style --foreground 42 "done: $DELETED/$FOUND deleted"
  fi
}

cmd_skills() {
  require ghq gum jq

  FOUND=0
  REPOS_FILE=$(mktemp)
  ghq list --full-path > "$REPOS_FILE"
  exec 3< "$REPOS_FILE"
  while IFS= read -r REPO <&3; do
    [ -f "$REPO/.git" ] && continue

    SKILLS_FILE=$(mktemp)
    for DIR in "$REPO/.claude/skills" "$REPO/.agents/skills"; do
      [ -d "$DIR" ] && find "$DIR" -mindepth 2 -maxdepth 2 -name SKILL.md
    done | sort > "$SKILLS_FILE"

    if [ -s "$SKILLS_FILE" ]; then
      OVERRIDES_RAW=""
      LOCAL_SETTINGS="$REPO/.claude/settings.local.json"
      if [ -f "$LOCAL_SETTINGS" ]; then
        OVERRIDES_RAW=$(jq -r '.skillOverrides // {} | to_entries[] | "\(.key)\t\(.value)"' "$LOCAL_SETTINGS" 2>/dev/null || true)
      fi

      gum style --foreground 212 "$REPO"
      exec 4< "$SKILLS_FILE"
      while IFS= read -r SKILL_MD <&4; do
        FOUND=$((FOUND + 1))
        NAME=$(skill_field "$SKILL_MD" name)
        [ -n "$NAME" ] || NAME=$(basename "$(dirname "$SKILL_MD")")
        DESC=$(skill_field "$SKILL_MD" description)
        if [ "${#DESC}" -gt 100 ]; then
          DESC="$(printf '%s' "$DESC" | cut -c1-97)..."
        fi
        OVERRIDE=""
        if [ -n "$OVERRIDES_RAW" ]; then
          OVERRIDE=$(printf '%s' "$OVERRIDES_RAW" | awk -F'\t' -v name="$NAME" '$1 == name {print $2}')
        fi
        if [ -n "$OVERRIDE" ] && [ "$OVERRIDE" != "on" ]; then
          printf '  %-32s %s  [%s]\n' "$NAME" "$DESC" "$OVERRIDE"
        else
          printf '  %-32s %s\n' "$NAME" "$DESC"
        fi
      done
      exec 4<&-
    fi
    rm -f "$SKILLS_FILE"
  done
  exec 3<&-
  rm -f "$REPOS_FILE"

  if [ "$FOUND" -eq 0 ]; then
    gum style --foreground 42 "no skills found"
  else
    gum style --foreground 42 "found $FOUND skill(s)"
  fi
}

if [ $# -eq 0 ] || [ "$1" = "-h" ]; then
  usage
  exit 0
fi

case "$1" in
  check)        shift; cmd_check "$@" ;;
  pull)         shift; cmd_pull "$@" ;;
  switch)       shift; cmd_switch "$@" ;;
  clean)        shift; cmd_clean "$@" ;;
  claude-local) shift; cmd_claude_local "$@" ;;
  skills)       shift; cmd_skills "$@" ;;
  *)
    printf '%srepos: unknown subcommand %s%s\n' "$RED" "'$1'" "$RESET" >&2
    usage
    exit 1
    ;;
esac
