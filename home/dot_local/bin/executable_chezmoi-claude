#!/bin/sh
### chezmoi-claude — diff and sync ~/.claude/settings.json against chezmoi source
###
### Renders ~/.claude/settings.json via `chezmoi cat`, normalizes both sides
### with `jq -S`, then either shows a delta diff (diff) or syncs on-disk
### values back into the chezmoi source fragments (sync). Self-contained;
### does not shell out to chezmoi-diffclaude / chezmoi-syncclaude.
###
### Usage:
###   chezmoi-claude diff    Show a normalized diff (rendered vs on-disk).
###   chezmoi-claude sync    Show the diff, confirm, then sync on-disk values
###                          back into the chezmoi source fragments.
###   chezmoi-claude local   Review and optionally delete per-repo local Claude
###                          settings (settings.local.json) across all ghq repos.
###
### Options:
###   -h   Show this message.

set -eu

usage() {
  sed -rn 's/^### ?//p' "$0"
}

require() {
  for cmd in "$@"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "Error: $cmd is not installed" >&2
      exit 1
    fi
  done
}

TARGET="$HOME/.claude/settings.json"

normalize_pair() {
  # $1 = path to write rendered template (sorted)
  # $2 = path to write on-disk file (sorted)
  if [ ! -f "$TARGET" ]; then
    echo "Error: missing $TARGET" >&2
    exit 2
  fi
  chezmoi cat "$TARGET" | jq -S . > "$1"
  jq -S . "$TARGET" > "$2"
}

cmd_diff() {
  require jq diffnav chezmoi

  RENDERED=$(mktemp)
  ACTUAL=$(mktemp)
  trap 'rm -f "$RENDERED" "$ACTUAL"' EXIT

  normalize_pair "$RENDERED" "$ACTUAL"

  if cmp -s "$RENDERED" "$ACTUAL"; then
    return 0
  fi

  git diff --no-index -- "$ACTUAL" "$RENDERED" | diffnav
  return 1
}

cmd_sync() {
  require jq gum diffnav chezmoi

  if cmd_diff; then
    gum style --foreground 42 "nothing to sync"
    return 0
  fi

  if ! gum confirm "Sync these changes back into the chezmoi source?"; then
    gum style --foreground 226 "aborted"
    return 1
  fi

  SOURCE=$(chezmoi source-path)
  MACHINE=$(chezmoi execute-template '{{ .machine }}')
  BASE_FILE="$SOURCE/.chezmoitemplates/claude_settings.json"

  case "$MACHINE" in
    personal) MACHINE_FILE="$SOURCE/.chezmoitemplates/claude_settings_personal.json" ;;
    work)     MACHINE_FILE="$SOURCE/.chezmoitemplates/encrypted_claude_settings_work.json" ;;
    *)
      gum style --foreground 196 "Error: unknown machine type '$MACHINE'"
      return 1
      ;;
  esac

  for f in "$TARGET" "$BASE_FILE" "$MACHINE_FILE"; do
    [ -f "$f" ] || { gum style --foreground 196 "Error: missing file $f"; return 1; }
  done

  gum style --foreground 212 "machine: $MACHINE"

  # Decrypt work machine file to a writable temp copy
  MACH_TMP=$(mktemp)
  trap 'rm -f "$MACH_TMP"' EXIT
  if [ "$MACHINE" = "work" ]; then
    chezmoi decrypt "$MACHINE_FILE" > "$MACH_TMP"
  else
    cp "$MACHINE_FILE" "$MACH_TMP"
  fi

  # Non-permissions top-level keys: route by presence in source files
  KEYS_TMP=$(mktemp)
  jq -r 'keys[] | select(. != "permissions")' "$TARGET" > "$KEYS_TMP"
  exec 4< "$KEYS_TMP"
  while IFS= read -r KEY <&4; do
    DISK_VAL=$(jq -c --arg k "$KEY" '.[$k]' "$TARGET")
    IN_MACH=$(jq -r --arg k "$KEY" 'has($k)' "$MACH_TMP")
    IN_BASE=$(jq -r --arg k "$KEY" 'has($k)' "$BASE_FILE")
    if [ "$IN_MACH" = "true" ]; then
      jq --arg k "$KEY" --argjson v "$DISK_VAL" '.[$k] = $v' "$MACH_TMP" > "${MACH_TMP}.new" && mv "${MACH_TMP}.new" "$MACH_TMP"
    elif [ "$IN_BASE" = "true" ]; then
      jq --arg k "$KEY" --argjson v "$DISK_VAL" '.[$k] = $v' "$BASE_FILE" > "${BASE_FILE}.new" && mv "${BASE_FILE}.new" "$BASE_FILE"
    else
      DEST=$(gum choose --header "New key '$KEY' — add to which file?" "base" "machine")
      case "$DEST" in
        base)    jq --arg k "$KEY" --argjson v "$DISK_VAL" '.[$k] = $v' "$BASE_FILE" > "${BASE_FILE}.new" && mv "${BASE_FILE}.new" "$BASE_FILE" ;;
        machine) jq --arg k "$KEY" --argjson v "$DISK_VAL" '.[$k] = $v' "$MACH_TMP" > "${MACH_TMP}.new" && mv "${MACH_TMP}.new" "$MACH_TMP" ;;
      esac
    fi
  done
  exec 4<&-
  rm -f "$KEYS_TMP"

  # permissions.allow and permissions.deny: item-level diff
  for LIST_KEY in allow deny; do
    NEW_TMP=$(mktemp)
    jq -rn \
      --slurpfile disk "$TARGET" \
      --slurpfile base "$BASE_FILE" \
      --slurpfile mach "$MACH_TMP" \
      --arg lk "$LIST_KEY" \
      '($disk[0].permissions[$lk] // []) as $d |
       (($base[0].permissions[$lk] // []) + ($mach[0].permissions[$lk] // [])) as $s |
       $d | map(select(. as $i | $s | index($i) | not)) | .[]' > "$NEW_TMP"
    exec 5< "$NEW_TMP"
    while IFS= read -r ITEM <&5; do
      DEST=$(gum choose --header "New permissions.$LIST_KEY: $ITEM" "base" "machine")
      case "$DEST" in
        base)
          jq --arg lk "$LIST_KEY" --arg i "$ITEM" '.permissions[$lk] += [$i]' "$BASE_FILE" > "${BASE_FILE}.new" && mv "${BASE_FILE}.new" "$BASE_FILE"
          ;;
        machine)
          jq --arg lk "$LIST_KEY" --arg i "$ITEM" \
            '.permissions //= {} | .permissions[$lk] //= [] | .permissions[$lk] += [$i]' \
            "$MACH_TMP" > "${MACH_TMP}.new" && mv "${MACH_TMP}.new" "$MACH_TMP"
          ;;
      esac
    done
    exec 5<&-
    rm -f "$NEW_TMP"

    # Drop items removed from on-disk list
    jq --slurpfile disk "$TARGET" --arg lk "$LIST_KEY" \
      'if .permissions[$lk] then
         .permissions[$lk] |= map(. as $i | select(($disk[0].permissions[$lk] // []) | index($i) != null))
       else . end' \
      "$BASE_FILE" > "${BASE_FILE}.new" && mv "${BASE_FILE}.new" "$BASE_FILE"
    jq --slurpfile disk "$TARGET" --arg lk "$LIST_KEY" \
      'if .permissions[$lk] then
         .permissions[$lk] |= map(. as $i | select(($disk[0].permissions[$lk] // []) | index($i) != null))
       else . end' \
      "$MACH_TMP" > "${MACH_TMP}.new" && mv "${MACH_TMP}.new" "$MACH_TMP"
  done

  # Non-array permissions sub-keys (e.g. defaultMode): route by presence in source files
  PKEYS_TMP=$(mktemp)
  jq -r '(.permissions // {}) | keys[] | select(. != "allow" and . != "deny" and . != "additionalDirectories")' "$TARGET" > "$PKEYS_TMP"
  exec 6< "$PKEYS_TMP"
  while IFS= read -r PKEY <&6; do
    DISK_VAL=$(jq -c --arg k "$PKEY" '.permissions[$k]' "$TARGET")
    IN_MACH=$(jq -r --arg k "$PKEY" '(.permissions // {}) | has($k)' "$MACH_TMP")
    if [ "$IN_MACH" = "true" ]; then
      jq --arg k "$PKEY" --argjson v "$DISK_VAL" '.permissions[$k] = $v' "$MACH_TMP" > "${MACH_TMP}.new" && mv "${MACH_TMP}.new" "$MACH_TMP"
    else
      jq --arg k "$PKEY" --argjson v "$DISK_VAL" '.permissions[$k] = $v' "$BASE_FILE" > "${BASE_FILE}.new" && mv "${BASE_FILE}.new" "$BASE_FILE"
    fi
  done
  exec 6<&-
  rm -f "$PKEYS_TMP"

  # Write back: re-encrypt for work
  if [ "$MACHINE" = "work" ]; then
    chezmoi encrypt "$MACH_TMP" > "$MACHINE_FILE"
  else
    cp "$MACH_TMP" "$MACHINE_FILE"
  fi

  gum style --foreground 42 "sync complete"
}

cmd_local() {
  require ghq bat gum

  FOUND=0
  DELETED=0
  REPOS_FILE=$(mktemp)
  ghq list --full-path > "$REPOS_FILE"
  exec 3< "$REPOS_FILE"
  while IFS= read -r REPO <&3; do
    [ -f "$REPO/.git" ] && continue
    SETTINGS="$REPO/.claude/settings.local.json"
    [ -f "$SETTINGS" ] || continue
    FOUND=$((FOUND + 1))

    gum style --foreground 212 "$REPO"
    bat --pager=never --language=json "$SETTINGS"

    CONFIRM_RC=0
    gum confirm --default=false "Delete?" || CONFIRM_RC=$?
    case "$CONFIRM_RC" in
      0)
        rm "$SETTINGS"
        rmdir "$REPO/.claude" 2>/dev/null || true
        DELETED=$((DELETED + 1))
        ;;
      1) ;;
      *) break ;;
    esac
  done
  exec 3<&-
  rm -f "$REPOS_FILE"

  if [ "$FOUND" -eq 0 ]; then
    gum style --foreground 42 "no local claude settings found"
  else
    gum style --foreground 42 "done: $DELETED/$FOUND deleted"
  fi
}

if [ $# -eq 0 ] || [ "$1" = "-h" ]; then
  usage
  exit 0
fi

case "$1" in
  diff)  shift; cmd_diff "$@" ;;
  sync)  shift; cmd_sync "$@" ;;
  local) shift; cmd_local "$@" ;;
  *)
    echo "Error: unknown subcommand '$1'" >&2
    usage >&2
    exit 1
    ;;
esac
