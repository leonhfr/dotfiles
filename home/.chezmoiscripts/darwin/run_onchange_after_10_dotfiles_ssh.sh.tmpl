#!/bin/bash
set -euo pipefail

ssh-add --apple-use-keychain ~/.ssh/id_ed25519

# Switch chezmoi repo remote from HTTPS to SSH once SSH keys are set up
current_remote=$(git -C {{ .chezmoi.sourceDir }} remote get-url origin)
if [[ "$current_remote" == git@github.com:* ]]; then
  echo "[dotfiles] Remote already using SSH, skipping"
elif ssh -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
  git -C {{ .chezmoi.sourceDir }} remote set-url origin git@github.com:{{ .git.github }}/dotfiles.git
  echo "[dotfiles] Switched dotfiles remote to SSH"
else
  echo "[dotfiles] SSH not authenticated with GitHub yet, skipping remote switch"
fi
