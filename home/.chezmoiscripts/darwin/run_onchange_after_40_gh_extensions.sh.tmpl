#!/bin/bash
# weekly: {{ now | date "2006-W01" }}
set -euo pipefail

extensions=(
  "dlvhdr/gh-dash"
  "dlvhdr/gh-enhance"
  "fchimpan/gh-workflow-stats"
  "github/gh-stack"
)

installed=$(gh extension list 2>/dev/null || true)

for ext in "${extensions[@]}"; do
  name="${ext##*/}"
  if echo "$installed" | grep -q "$name"; then
    echo "[dotfiles] gh extension already installed: $name"
  else
    echo "[dotfiles] Installing gh extension: $ext"
    gh extension install "$ext"
  fi
done

gh extension upgrade --all
