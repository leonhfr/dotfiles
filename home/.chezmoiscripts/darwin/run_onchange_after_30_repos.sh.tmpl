#!/bin/bash
set -euo pipefail

# common:   {{ include "GitHub/encrypted_common.yaml" | sha256sum }}
# personal: {{ include "GitHub/encrypted_personal.yaml" | sha256sum }}
# work:     {{ include "GitHub/encrypted_work.yaml" | sha256sum }}

eval "$(/opt/homebrew/bin/brew shellenv)"

echo "[dotfiles] Syncing repos"
mani sync --config "$HOME/GitHub/mani.yaml" --parallel
