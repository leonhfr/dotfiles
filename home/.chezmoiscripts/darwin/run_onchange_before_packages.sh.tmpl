#!/bin/bash

eval "$(/opt/homebrew/bin/brew shellenv)"

{{- $cp := .packages.common -}}
{{- $mp := index .packages .machine -}}

echo "[dotfiles] Installing packages"

brew bundle --file=/dev/stdin <<EOF
{{ range concat $cp.brews $mp.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range concat $cp.casks $mp.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

if command -v rustup >/dev/null 2>&1; then
    if ! command -v cargo >/dev/null 2>&1; then
        echo "[dotfiles] Installing Rust"
        rustup-init -y
    fi

    rustup component add rust-src
fi

echo "[dotfiles] Installing go packages"

{{ range concat $cp.go $mp.go -}}
go install {{ . }}
{{ end -}}
