#!/bin/bash
set -euo pipefail

# herdr claude integration: {{ output "sh" "-c" "command -v herdr >/dev/null 2>&1 && herdr integration status 2>/dev/null | grep '^claude:' || echo 'herdr not installed'" | trim }}
# herdr plugin update week: {{ now | date "2006-W01" }}

plugins=(
    "devashish2203/herdr-worktrunk"
    "persiyanov/herdr-reviewr"
    "thanhdat77/herdr-navigator"
)

local_plugins=(
    "$HOME/src/github.com/leonhfr/herdr-worktree-groups"
)

if ! command -v cargo >/dev/null 2>&1; then
  echo "[dotfiles] missing cargo, skipping GitHub herdr plugins..."
else
  export PATH="$(brew --prefix rustup)/bin:$HOME/.cargo/bin:$PATH"

  for plugin in "${plugins[@]}"; do
      echo "[dotfiles] Updating herdr plugin: $plugin"
      herdr plugin uninstall "$plugin" >/dev/null 2>&1 || true
      herdr plugin install "$plugin" --yes
  done
fi

for plugin_path in "${local_plugins[@]}"; do
    if [[ ! -d $plugin_path ]]; then
        echo "[dotfiles] local herdr plugin path missing, skipping: $plugin_path"
        continue
    fi
    echo "[dotfiles] Linking herdr plugin: $plugin_path"
    herdr plugin link "$plugin_path" >/dev/null
done

claude_integration_status=$(herdr integration status 2>/dev/null | grep '^claude:' || true)
if echo "$claude_integration_status" | grep -q 'current'; then
    echo "[dotfiles] herdr claude integration already current"
else
    echo "[dotfiles] Installing herdr claude integration"
    herdr integration install claude
fi
