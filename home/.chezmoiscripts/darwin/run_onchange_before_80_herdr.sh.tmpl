#!/bin/bash
set -euo pipefail

plugins=(
    "devashish2203/herdr-worktrunk"
    "persiyanov/herdr-reviewr"
    "thanhdat77/herdr-navigator"
)

if ! command -v cargo >/dev/null 2>&1; then
  echo "[dotfiles] missing cargo, skipping herdr plugins..."
  exit 0
fi

installed=$(herdr plugin list 2>/dev/null || true)

export PATH="$(brew --prefix rustup)/bin:$HOME/.cargo/bin:$PATH"

for plugin in "${plugins[@]}"; do
    if echo "$installed" | grep -q "$plugin"; then
        echo "[dotfiles] herdr plugin already installed: $plugin"
    else
        echo "[dotfiles] Installing herdr plugin: $plugin"
        herdr plugin install "$plugin" --yes
    fi
done
