#!/bin/bash
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

echo "[dotfiles] Installing packages"

BREWFILE=$(mktemp)
trap 'rm -f "$BREWFILE"' EXIT

cat > "$BREWFILE" <<EOF
{{ $brews := concat (.brews.common | default (list)) (index .brews .machine | default (list)) | sortAlpha | uniq -}}
{{ $casks := concat (.casks.common | default (list)) (index .casks .machine | default (list)) | sortAlpha | uniq -}}
{{ $vscode := concat (.vscode.common | default (list)) (index .vscode .machine | default (list)) | sortAlpha | uniq -}}
{{ range $brews -}}
brew {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}{{ if contains "/" . }}, trusted: true{{ end }}
{{ end -}}
{{ range $vscode -}}
vscode {{ . | quote }}
{{ end -}}
EOF

brew bundle --force --file="$BREWFILE"

echo "[dotfiles] Cleaning up packages"

brew bundle cleanup --force --file="$BREWFILE" || true
