#!/bin/bash
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

{{- $brews := concat (.brews.common | default (list)) (index .brews .machine | default (list)) -}}
{{- $casks := concat (.casks.common | default (list)) (index .casks .machine | default (list)) -}}

echo "[dotfiles] Installing packages"

brew bundle --file=/dev/stdin <<EOF
{{ range $brews | sortAlpha | uniq -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks | sortAlpha | uniq -}}
cask {{ . | quote }}
{{ end -}}
EOF

if command -v rustup >/dev/null 2>&1; then
    if ! command -v cargo >/dev/null 2>&1; then
        echo "[dotfiles] Installing Rust"
        rustup-init -y
    fi

    rustup component list --installed | grep -q '^rust-src' || rustup component add rust-src
fi
