#!/bin/sh
### chezmoi-syncclaude — sync ~/.claude/settings.json back to the chezmoi source
###
### Reads $HOME/.claude/settings.json and writes each top-level key into either
### the common fragment (claude_settings.json) or the current machine's fragment
### (claude_settings_personal.json on personal, encrypted_claude_settings_work.json
### on work), per the mapping in .chezmoidata/claude_settings_mapping.yaml.
### Unknown keys are prompted via gum.
###
### Usage:
###   chezmoi-syncclaude
###
### Options:
###   -h   Show this message.

set -eu

if [ "${1:-}" = "-h" ]; then
  sed -rn 's/^### ?//p' "$0"
  exit 0
fi

for cmd in jq yq gum chezmoi; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: $cmd is not installed" >&2
    exit 1
  fi
done

SOURCE=$(chezmoi source-path)
MACHINE=$(chezmoi execute-template '{{ .machine }}')

RENDERED="$HOME/.claude/settings.json"
COMMON_FILE="$SOURCE/.chezmoitemplates/claude_settings.json"
MAP_FILE="$SOURCE/.chezmoidata/claude_settings_mapping.yaml"

case "$MACHINE" in
  personal) MACHINE_FILE="$SOURCE/.chezmoitemplates/claude_settings_personal.json" ;;
  work) MACHINE_FILE="$SOURCE/.chezmoitemplates/encrypted_claude_settings_work.json" ;;
  *)
    gum style --foreground 196 "Error: unknown machine type '$MACHINE'"
    exit 1
    ;;
esac

for f in "$RENDERED" "$COMMON_FILE" "$MACHINE_FILE" "$MAP_FILE"; do
  if [ ! -f "$f" ]; then
    gum style --foreground 196 "Error: missing file $f"
    exit 1
  fi
done

gum style --foreground 212 "machine: $MACHINE"

NEW_MAPPINGS=""
for KEY in $(jq -r 'keys[]' "$RENDERED"); do
  BUCKET=$(K="$KEY" yq '.claude_settings_mapping[strenv(K)] // ""' "$MAP_FILE")
  if [ -z "$BUCKET" ] || [ "$BUCKET" = "null" ]; then
    NEW=$(gum choose --header "Where should '$KEY' go?" common machine)
    if [ -z "$NEW" ]; then
      gum style --foreground 196 "Aborted."
      exit 1
    fi
    K="$KEY" V="$NEW" yq -i '.claude_settings_mapping[strenv(K)] = strenv(V)' "$MAP_FILE"
    NEW_MAPPINGS="$NEW_MAPPINGS $KEY=$NEW"
  fi
done

yq -i 'sort_keys(.claude_settings_mapping)' "$MAP_FILE"

MAP_JSON_FILE=$(mktemp)
yq -o json '.claude_settings_mapping' "$MAP_FILE" > "$MAP_JSON_FILE"

NEW_COMMON=$(jq --sort-keys \
  --slurpfile mapping "$MAP_JSON_FILE" \
  --slurpfile current "$COMMON_FILE" \
  --slurpfile rendered "$RENDERED" '
    $mapping[0] as $m |
    ($current[0] * ($rendered[0] | with_entries(select($m[.key] == "common"))))
    | with_entries(select($m[.key] != "machine"))
  ' -n)

NEW_MACHINE=$(jq --sort-keys \
  --slurpfile mapping "$MAP_JSON_FILE" \
  --slurpfile current "$MACHINE_FILE" \
  --slurpfile rendered "$RENDERED" '
    $mapping[0] as $m |
    ($current[0] * ($rendered[0] | with_entries(select($m[.key] == "machine"))))
    | with_entries(select($m[.key] != "common"))
  ' -n)

rm -f "$MAP_JSON_FILE"

COMMON_TMP=$(mktemp)
MACHINE_TMP=$(mktemp)
printf '%s\n' "$NEW_COMMON" > "$COMMON_TMP"
printf '%s\n' "$NEW_MACHINE" > "$MACHINE_TMP"
mv "$COMMON_TMP" "$COMMON_FILE"
mv "$MACHINE_TMP" "$MACHINE_FILE"

ORPHANS_COMMON=$(jq -r --slurpfile rendered "$RENDERED" '
  keys[] | select(. as $k | ($rendered[0] | has($k)) | not)
' "$COMMON_FILE")
ORPHANS_MACHINE=$(jq -r --slurpfile rendered "$RENDERED" '
  keys[] | select(. as $k | ($rendered[0] | has($k)) | not)
' "$MACHINE_FILE")

gum style --foreground 42 "sync complete"
if [ -n "$NEW_MAPPINGS" ]; then
  gum style --foreground 226 "new mappings:$NEW_MAPPINGS"
fi
if [ -n "$ORPHANS_COMMON" ]; then
  gum style --foreground 226 "orphan keys in common (left untouched):"
  echo "$ORPHANS_COMMON" | sed 's/^/  /'
fi
if [ -n "$ORPHANS_MACHINE" ]; then
  gum style --foreground 226 "orphan keys in machine fragment (left untouched):"
  echo "$ORPHANS_MACHINE" | sed 's/^/  /'
fi
