{
  "enabledPlugins": {
    "gopilot@gopilot": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "gopilot": {
      "source": {
        "source": "git",
        "url": "git@github.com:gonzaloserrano/gopilot.git"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
