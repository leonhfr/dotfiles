{
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": true,
  "awaySummaryEnabled": false,
  "cleanupPeriodDays": 180,
  "companyAnnouncements": [
    "Welcome back, boss!"
  ],
  "disableAgentView": true,
  "disableDeepLinkRegistration": "disable",
  "effortLevel": "xhigh",
  "enableWorkflows": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "env": {
    "ANTHROPIC_MODEL": "sonnet",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "0",
    "CLAUDE_CODE_DISABLE_CRON": "0",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "0",
    "CLAUDE_CODE_DISABLE_WORKFLOWS": "0",
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_UPGRADE_COMMAND": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "fallbackModel": [
    "claude-sonnet-5",
    "claude-sonnet-4-6",
    "claude-haiku-4-5"
  ],
  "fastMode": false,
  "fileCheckpointingEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "includeGitInstructions": false,
  "minimumVersion": "2.1.168",
  "model": "sonnet-4-6",
  "outputStyle": "Simplified Technical English",
  "permissions": {
    "allow": [
      "Read(~/src/**)",
      "Read(~/go/**)",
      "Grep",
      "Glob",
      "Skill",
      "WebSearch",
      "WebFetch",
      "Bash(awk *)",
      "Bash(bat *)",
      "Bash(brew config)",
      "Bash(brew doctor)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(brew search *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(docker compose build *)",
      "Bash(docker compose config *)",
      "Bash(docker compose down *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose pull *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose start *)",
      "Bash(docker compose stop *)",
      "Bash(docker compose up *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(echo *)",
      "Bash(eza *)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh workflow-stats *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git stash list *)",
      "Bash(git status)",
      "Bash(go build *)",
      "Bash(go doc *)",
      "Bash(go env *)",
      "Bash(go list *)",
      "Bash(go mod *)",
      "Bash(go run *)",
      "Bash(go test *)",
      "Bash(go version *)",
      "Bash(go vet *)",
      "Bash(golangci-lint *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(hugo *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(pdfcpu *)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)",
      "Bash(printf *)",
      "Bash(rg *)",
      "Bash(sleep *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(tree *)",
      "Bash(type *)",
      "Bash(uname *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(xargs cat)",
      "Bash(yq *)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "prefersReducedMotion": true,
  "remoteControlAtStartup": false,
  "respondToBashCommands": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "skillListingBudgetFraction": 0.05,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Processing"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "theme": "auto",
  "tui": "fullscreen",
  "voice": { "enabled": true, "mode": "hold" }
}
