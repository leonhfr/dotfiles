{
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "awaySummaryEnabled": false,
  "companyAnnouncements": ["Welcome back, boss!"],
  "disableDeepLinkRegistration": "disable",
  "effortLevel": "xhigh",
  "env": {
    "ANTHROPIC_MODEL": "claude-opus-4-7",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "fastMode": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Skill",
      "WebSearch",
      "WebFetch",
      "Bash(awk *)",
      "Bash(find *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr view *)",
      "Bash(gh search *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(go test *)",
      "Bash(grep *)",
      "Bash(ls:*)",
      "Bash(make *)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)",
      "Bash(rtk find *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh search *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk git show *)",
      "Bash(rtk git status)",
      "Bash(rtk glob *)",
      "Bash(rtk go test *)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk make *)",
      "Bash(rtk read *)",
      "Bash(rtk wc *)",
      "mcp__mcp-gateway__mcp-clickhouse-list-databases",
      "mcp__mcp-gateway__mcp-clickhouse-list-tables",
      "mcp__mcp-gateway__mcp-clickhouse-run-select-query",
      "mcp__notion__notion-fetch",
      "mcp__plugin_sentry_sentry__search_events",
      "mcp__plugin_sentry_sentry__search_issues",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__slack__slack_read_file",
      "mcp__slack__slack_read_thread"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rtk git push *)",
      "Bash(rtk rm -rf *)",
      "Bash(rtk read ./.env)",
      "Bash(rtk read ./.env.*)"
    ]
  },
  "prefersReducedMotion": true,
  "remoteControlAtStartup": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Processing"]
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  }
}
