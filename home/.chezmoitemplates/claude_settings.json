{
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "awaySummaryEnabled": false,
  "disableDeepLinkRegistration": "disable",
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "fastMode": false,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(ls:*)",
      "Bash(rtk read *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk glob *)",
      "Bash(rtk git status)",
      "Bash(rtk git diff *)",
      "Bash(rtk ls *)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rtk git push *)",
      "Bash(rtk rm -rf *)",
      "Bash(rtk read ./.env)",
      "Bash(rtk read ./.env.*)"
    ]
  },
  "prefersReducedMotion": true,
  "remoteControlAtStartup": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Processing"
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  }
}
