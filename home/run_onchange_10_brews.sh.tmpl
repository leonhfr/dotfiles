{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

eval "$(/opt/homebrew/bin/brew shellenv)"

echo "[dotfiles] Installing packages"

brew bundle --file=/dev/stdin <<EOF
{{ range .homebrew.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .homebrew.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
