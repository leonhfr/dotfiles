{{- $base := include ".chezmoitemplates/claude_settings.json" | fromJson -}}
{{- $machine := dict -}}
{{- if eq .machine "work" -}}
{{-   $machine = include ".chezmoitemplates/encrypted_claude_settings_work.json" | fromJson -}}
{{- else if eq .machine "personal" -}}
{{-   $machine = include ".chezmoitemplates/claude_settings_personal.json" | fromJson -}}
{{- end -}}
{{- $merged := deepCopy $base -}}
{{- range $k, $mv := $machine -}}
{{-   $bv := index $base $k -}}
{{-   if and $bv (eq (kindOf $mv) "slice") (eq (kindOf $bv) "slice") -}}
{{-     $_ := set $merged $k (concat $bv $mv | uniq) -}}
{{-   else if and $bv (eq (kindOf $mv) "map") (eq (kindOf $bv) "map") -}}
{{-     $nested := deepCopy $bv -}}
{{-     range $nk, $nv := $mv -}}
{{-       $nbv := index $bv $nk -}}
{{-       if and $nbv (eq (kindOf $nv) "slice") (eq (kindOf $nbv) "slice") -}}
{{-         $_ := set $nested $nk (concat $nbv $nv | uniq) -}}
{{-       else -}}
{{-         $_ := set $nested $nk $nv -}}
{{-       end -}}
{{-     end -}}
{{-     $_ := set $merged $k $nested -}}
{{-   else -}}
{{-     $_ := set $merged $k $mv -}}
{{-   end -}}
{{- end -}}
{{ $merged | toPrettyJson }}
