{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)"
    ],
    "defaultMode": "plan"
  },
  "awaySummaryEnabled": false,
  "remoteControlAtStartup": false,
  "alwaysThinkingEnabled": true,
  "prefersReducedMotion": true,
  "attribution": {
    "commits": false,
    "pullRequests": false
  },
  "disableDeepLinkRegistration": "disable",
  "fastMode": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
