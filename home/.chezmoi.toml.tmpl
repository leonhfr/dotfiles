{{- $machineTypes := list "personal" "work" -}}
{{- $machine := promptChoiceOnce . "machine" "What type of machine" $machineTypes -}}

{{- $workEmail := "" -}}
{{- $workGithub := "" -}}
{{- $workOpAccount := "" -}}
{{- $workOpVault := "" -}}

{{- if eq $machine "work" -}}
{{- $workEmail = promptStringOnce . "work_email" "Work email address" -}}
{{- $workGithub = promptStringOnce . "work_github" "Work GitHub username" -}}
{{- $workOpAccount = promptStringOnce . "work_op_account" "Work 1Password account shorthand" -}}
{{- $workOpVault = promptStringOnce . "work_op_vault" "Work 1Password vault name" "Private" -}}
{{- end -}}

[data]
  machine = {{ $machine | quote }}
  work_email = {{ $workEmail | quote }}
  work_github = {{ $workGithub | quote }}
  work_op_account = {{ $workOpAccount | quote }}
  work_op_vault = {{ $workOpVault | quote }}

[data.personal]
  name = "léon h"
  email = "hello@leonh.fr"
  github = "leonhfr"

[data.personal.op]
  account = "my"
  ssh_public_key = "op://Personal/GitHub SSH Key/public key"
  ssh_private_key = "op://Personal/GitHub SSH Key/private key"
  chezmoi_token = "op://Personal/chezmoi GitHub API Token/credential"

[data.work]
  name = "Léon Hollender"
  email = {{ $workEmail | quote }}
  github = {{ $workGithub | quote }}

[data.work.op]
  account = {{ $workOpAccount | quote }}
  ssh_public_key = "op://{{ $workOpVault }}/GitHub SSH Key/public key"
  ssh_private_key = "op://{{ $workOpVault }}/GitHub SSH Key/private key"
  chezmoi_token = "op://{{ $workOpVault }}/chezmoi GitHub API Token/credential"

[hooks.read-source-state.pre]
  command = ".local/share/chezmoi/bin/.install-prerequisites.sh"
