providers:
  edgee:
    api: openai-completions
    apiKey: EDGEE_API_KEY
    baseUrl: https://eu.edgee.io/v1
    headers:
      x-edgee-api-key: EDGEE_API_KEY
      x-edgee-session-id: EDGEE_SESSION_ID
    models:
      - contextWindow: 1050000
        cost:
          cacheRead: 0.01
          cacheWrite: 0.125
          input: 0.1
          output: 0.5
        id: openai/gpt-6-luna
        input:
          - text
          - image
        maxTokens: 64000
        name: openai/gpt-6-luna
        reasoning: true
        thinkingLevelMap:
          high: high
          low: low
          max: max
          medium: medium
          minimal: null
          off: none
          xhigh: xhigh
      - contextWindow: 1050000
        cost:
          cacheRead: 0.1
          cacheWrite: 2.5
          input: 2.0
          output: 10.0
        id: openai/gpt-6.1-sol
        input:
          - text
          - image
        maxTokens: 64000
        name: openai/gpt-6.1-sol
        reasoning: true
        thinkingLevelMap:
          high: high
          low: low
          max: max
          medium: medium
          minimal: null
          off: null
          xhigh: xhigh
    name: Edgee
  edgee-anthropic:
    api: anthropic-messages
    apiKey: EDGEE_API_KEY
    baseUrl: https://eu.edgee.io
    disableStrictTools: true
    headers:
      User-Agent: omp
      x-edgee-api-key: EDGEE_API_KEY
      x-edgee-session-id: EDGEE_SESSION_ID
    models:
      - compat:
          allowAnthropicHeaderOverrides: true
          injectClaudeCodeInstruction: false
        contextWindow: 200000
        cost:
          cacheRead: 0.1
          cacheWrite: 1.25
          input: 1.0
          output: 5.0
        id: anthropic/claude-haiku-4-5
        input:
          - text
          - image
        maxTokens: 64000
        name: anthropic/claude-haiku-4-5
      - compat:
          allowAnthropicHeaderOverrides: true
          injectClaudeCodeInstruction: false
        contextWindow: 1000000
        cost:
          cacheRead: 0.2
          cacheWrite: 5.0
          input: 4.0
          output: 20.0
        id: anthropic/claude-opus-5-5
        input:
          - text
          - image
        maxTokens: 64000
        name: anthropic/claude-opus-5-5
        reasoning: true
        thinkingLevelMap:
          high: high
          low: low
          max: max
          medium: medium
          minimal: null
          off: null
          xhigh: xhigh
      - compat:
          allowAnthropicHeaderOverrides: true
          injectClaudeCodeInstruction: false
        contextWindow: 1000000
        cost:
          cacheRead: 0.2
          cacheWrite: 2.5
          input: 2.0
          output: 10.0
        id: anthropic/claude-sonnet-5-5
        input:
          - text
          - image
        maxTokens: 64000
        name: anthropic/claude-sonnet-5-5
        reasoning: true
        thinkingLevelMap:
          high: high
          low: low
          max: max
          medium: medium
          minimal: null
          off: null
          xhigh: xhigh
    name: Edgee (Anthropic)
  typesafe:
    apiKey: TYPESAFE_API_KEY
