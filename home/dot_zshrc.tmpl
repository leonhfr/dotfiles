# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# XDG
export XDG_DATA_HOME=$HOME/.local/share
export XDG_CONFIG_HOME=$HOME/.config
export XDG_STATE_HOME=$HOME/.local/state
export XDG_CACHE_HOME=$HOME/.cache

# antidote
HIST_STAMPS="yyyy-mm-dd"
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"

autoload -Uz compinit && compinit

source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
antidote load

# options
setopt autocd

# env
export GPG_TTY=$(tty)
{{ $machineOp := eq .machine "work" | ternary .work.op .personal.op -}}
export CHEZMOI_GITHUB_ACCESS_TOKEN={{ onepasswordRead $machineOp.chezmoi_token $machineOp.account }}

function git_main_branch() {
  git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || echo main
}

function navialias() {
  navi --query ":: $1" --best-match
}

# aliases
alias g="git"
alias ga="git add"
alias gaa="git add --all"
alias gapa="git add --patch"
alias gb="git branch"
alias gbd="git branch --delete"
alias gco="git checkout --quiet"
alias gcb="git checkout --quiet -b"
alias gcm='git checkout --quiet $(git_main_branch)'
alias gc="git commit --quiet --verbose"
alias gc!="git commit --quiet --verbose --amend --no-edit"
alias gd="git diff"
alias gds="git diff --staged"
alias gf="git fetch"
alias gfa="git fetch --all --tags --prune --jobs=10"
alias glo="git log --oneline --decorate"
alias glog="git log --oneline --decorate --graph"
alias gl="git pull"
alias gp="git push --quiet"
alias grb="git rebase --quiet"
alias grh="git reset --soft"
alias grs="git restore"
alias gsh="git show"
alias gsta="git stash push"
alias gstc="git stash clear"
alias gstl="git stash list"
alias gstp="git stash pop"
alias gst="git status --short --branch"
alias gsw="git switch --quiet"
alias gswc="git switch --quiet --create"
alias gswm='git switch --quiet $(git_main_branch)'
alias grt='cd "$(git rev-parse --show-toplevel || echo .)"'
alias gt="git town"

alias cat="bat"
alias c="claude"
alias cc="claude"
alias cdd='cd "$SHELL_START_DIR"'
alias cm="chezmoi"
alias cma="chezmoi apply"
alias cmd="chezmoi diff"
command -v kubectl >/dev/null && alias k="kubectl"
command -v kubectx >/dev/null && alias kctx="kubectx"
alias m="mise"
alias mr="mise run"
alias zd="zed"

alias ls='eza --all --long --color=always --group-directories-first --icons=always'
alias la='eza --all --color=always --group-directories-first --icons=always'
alias ll='eza --long --color=always --group-directories-first --icons=always'
alias lt='eza --all --tree --git-ignore --color=always --group-directories-first --icons=always'
alias lt1='eza --all --tree --git-ignore --color=always --group-directories-first --icons=always --level 1'
alias lt2='eza --all --tree --git-ignore --color=always --group-directories-first --icons=always --level 2'
alias lt3='eza --all --tree --git-ignore --color=always --group-directories-first --icons=always --level 3'
alias lt4='eza --all --tree --git-ignore --color=always --group-directories-first --icons=always --level 4'
alias l.="eza --all | grep -e '^\.'"

alias rgi="rg -i"
alias rgv="rg -v"
alias rgvi="rg -vi"
alias rggo="rg -tgo -F -g '!vendor/'"
alias rgmd="rg -tmarkdown"

alias ..="cd .."
alias ...="cd ../../"
alias ....="cd ../../../"
alias .....="cd ../../../../"

export LESS=-RFX

command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v navi >/dev/null && eval "$(navi widget zsh)"
command -v thefuck >/dev/null && eval "$(thefuck --alias)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
